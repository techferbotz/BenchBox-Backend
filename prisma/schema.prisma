// BenchBox schema. Prisma 6 is pinned on purpose (HOA protocol 04): v7 drops `url = env(...)` and
// needs a driver adapter. Every Prisma call lives in a repository — no Prisma anywhere else.
// Migrations are a discrete step (`migrate` compose service), never run on container start.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A BenchBox account. Users sign in with Google; the identity is Google's stable `sub`, never the
/// email (which can change).
model User {
  id          String    @id @default(uuid()) @db.Uuid
  /// Google's `sub`. Cleared when the account is deleted, so the same Google account can sign up
  /// again as a NEW account while this row stays behind, anonymised, as the anchor for records that
  /// must outlive the account (statements and payments, from P5).
  googleSub   String?   @unique
  email       String?
  name        String?
  photoUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set by DELETE /api/v1/me. The personal fields above are cleared in the same transaction.
  deletedAt   DateTime?
  /// The last sync sequence handed out for this user's tree (deviation D4). Every tree change
  /// increments it first — taking this row's lock — and stamps every node it touches with the new
  /// value, so sequence order is commit order and the change feed can never skip a change.
  syncSeq     BigInt    @default(0)
  /// The oldest point the change feed can still replay completely. Compaction deletes old
  /// tombstones and raises it; a device whose cursor is below it must resync (410 RESYNC_REQUIRED).
  syncFloor   BigInt    @default(0)
  /// The bytes the user is billed for right now: the verified size of every file they have, files
  /// in the trash included, until purged. Always equal to the newest StorageEvent's `totalAfter`.
  /// Changed ONLY by recordStorageChange() (modules/metering), in the transaction that changes the
  /// bytes, under this row's lock.
  storedBytes BigInt    @default(0)

  sessions       Session[]
  nodes          Node[]
  uploads        UploadSession[]
  blobs          Blob[]
  storageEvents  StorageEvent[]
  usageDays      UsageDay[]
  statements     Statement[]
  billingAccount BillingAccount?
  notifications  Notification[]
}

enum NodeKind {
  FOLDER
  FILE
}

/// A folder or a file in a user's tree. A file is created by a completed upload; the tree, trash
/// and sync treat both kinds the same.
///
/// Invariants the service keeps, all under the user's row lock:
///   - An active node's ancestors are all active, so trashing a folder trashes everything inside it.
///   - Active siblings have distinct `nameKey`s (case-insensitive names). Enforced in the service
///     rather than by a partial unique index, which Prisma 6 can't express; the per-user lock makes
///     the check race-free.
///   - A node is never moved into its own subtree.
model Node {
  /// Generated by the app; writes are idempotent by id.
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  /// Null = the root of the user's tree.
  parentId     String?   @db.Uuid
  kind         NodeKind
  /// As the user typed it (trimmed, NFC). Cleared when the node is purged.
  name         String
  /// NFC + lower-case `name`: the key for sibling uniqueness and for search.
  nameKey      String
  /// Files: verified bytes of the current content (the blob's size).
  size         BigInt    @default(0)
  /// Files: as the app declared it at upload.
  mimeType     String?
  /// Files: the stored content. Replacing a file's content points it at a new blob. A purged
  /// node keeps the link; the blob itself is marked purged in the same transaction.
  blobId       String?   @unique @db.Uuid
  /// Files: whether the current content has a thumbnail (the blob's `thumbKey`), so every node
  /// read can say so without a join.
  hasThumbnail Boolean   @default(false)
  trashedAt    DateTime?
  /// The node the user put in the trash. Everything trashed in that one action shares it, so a
  /// restore brings back exactly that batch.
  trashRootId  String?   @db.Uuid
  /// Tombstone: set when purged. The row stays (names cleared) so devices learn about the delete
  /// through the change feed, until compaction removes it.
  deletedAt    DateTime?
  /// The user's sync sequence of the transaction that last changed this node.
  syncSeq      BigInt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NoAction (checked at the end of each statement), so a whole purged subtree can be removed in
  /// one statement by compaction.
  parent   Node?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Node[] @relation("NodeTree")
  blob     Blob?  @relation(fields: [blobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, parentId, nameKey])
  /// Led by parentId: the self-referencing foreign key checks it for every deleted node (account
  /// deletion, compaction), and subtree walks step through it one folder at a time.
  @@index([parentId])
  @@index([userId, syncSeq, id])
  @@index([userId, trashedAt])
  @@index([trashedAt])
  @@index([deletedAt])
}

enum UploadState {
  PENDING
  COMPLETED
  ABORTED
  EXPIRED
  FAILED
}

/// One object in R2: a file's content, with the app-made thumbnail beside it (deviations D2, D3).
/// Object keys never contain file names.
model Blob {
  /// The id of the upload that created it.
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  /// The bucket it lives in, so moving to another bucket later needs no rewrite of the keys.
  bucket    String
  /// u/{userId}/{blobId}
  objectKey String    @unique
  /// t/{userId}/{blobId}.webp, or null when the app sent no thumbnail. Thumbnails are not billed.
  thumbKey  String?   @unique
  /// Measured with HeadObject after the upload. Never the size the client declared.
  size      BigInt
  createdAt DateTime  @default(now())
  /// When the bytes stopped being billed (purge, replacement, account deletion). The object's
  /// deletion was queued in the outbox in that same transaction.
  purgedAt  DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  node Node?

  @@index([userId, purgedAt])
}

/// An upload in progress, straight from the app to R2 through presigned URLs (deviation D2). The
/// object key is reserved here BEFORE any URL is issued, so the bucket never holds an object the
/// database doesn't know about.
model UploadSession {
  /// Generated by the app; starting again with the same id returns this session.
  id           String      @id @db.Uuid
  userId       String      @db.Uuid
  /// The id the new file node gets. (Replacing an existing file keeps that file's id instead.)
  fileId       String      @db.Uuid
  parentId     String?     @db.Uuid
  /// Normalised like every node name.
  name         String
  mimeType     String
  declaredSize BigInt
  /// fail | rename | replace: what to do when the name is taken.
  onConflict   String
  /// u/{userId}/{id}
  objectKey    String      @unique
  /// The thumbnail size the app declared (t/{userId}/{id}.webp); null = no thumbnail.
  thumbSize    Int?
  /// R2's multipart upload id. Null for a single PUT, or until R2 has been asked for one.
  r2UploadId   String?
  /// Multipart only: every part but the last is exactly this size (an R2 rule).
  partSize     Int?
  partCount    Int?
  state        UploadState @default(PENDING)
  /// The node a completed upload produced.
  resultNodeId String?     @db.Uuid
  createdAt    DateTime    @default(now())
  /// Slides forward with every request about the upload, never past the hard limit.
  expiresAt    DateTime
  endedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([state, expiresAt])
}

/// Append-only log of every change to a user's stored bytes: the metering source of truth. Bills
/// (P4) are computed from it, so they can be recomputed and audited at any time.
model StorageEvent {
  id         BigInt   @id @default(autoincrement())
  userId     String   @db.Uuid
  at         DateTime
  /// Signed.
  deltaBytes BigInt
  /// User.storedBytes after this change.
  totalAfter BigInt
  /// UPLOAD | REPLACE | PURGE | ACCOUNT_DELETE | ADMIN
  reason     String
  /// What caused it: a blob or node id.
  refId      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A user's events in id order are in commit order: they are inserted under the user's row lock.
  @@index([userId, id])
  @@index([userId, at])
}

/// Prices, versioned by the IST month they take effect in (docs/BACKEND_PLAN.md §7.1). Data, not
/// constants: the numbers are suggested defaults the owner hasn't confirmed (§13), so a confirmed
/// price is a new row, not a deploy. A row prices every day from `effectiveFrom` until a later row
/// takes over, except that a price INCREASE never applies before PRICE_CHANGE_NOTICE_DAYS after it
/// was recorded (metering.rules.ts). Never edit a row that has priced a day: add a new one.
model PriceBook {
  id                     String   @id @default(uuid()) @db.Uuid
  /// The IST date it takes effect: always the 1st of a month (a CHECK constraint), so a month has
  /// one price.
  effectiveFrom          DateTime @unique @db.Date
  /// 250 = ₹2.50 per GB-month (1 GB = 10⁹ bytes).
  storagePaisePerGbMonth BigInt
  /// Free storage. Each day is billed only for its byte-seconds above freeBytes × 86,400, and an
  /// account without auto-pay may store at most this much (the storage allowance).
  freeBytes              BigInt
  /// 1800 = 18% GST.
  gstBasisPoints         Int
  /// A statement whose total is below this is carried into the account's next statement instead
  /// of being charged.
  minimumChargePaise     BigInt
  /// Why the row exists: the decision or the announcement behind it.
  note                   String?
  /// When it was recorded: a price increase's notice period starts here.
  createdAt              DateTime @default(now())

  usageDays  UsageDay[]
  statements Statement[]
}

/// One account's metered storage for one IST day, written once by the daily close
/// (metering.closeDay) from the StorageEvent log and never changed, so re-running a close writes
/// nothing. A day with nothing stored and no change has no row.
model UsageDay {
  userId              String   @db.Uuid
  /// The IST calendar date.
  day                 DateTime @db.Date
  /// ∫ stored bytes dt over the day. Exact: event times are milliseconds, hence three decimals.
  byteSeconds         Decimal  @db.Decimal(38, 3)
  /// The part of byteSeconds above the day's free allowance (freeBytes × 86,400), or 0.
  billableByteSeconds Decimal  @db.Decimal(38, 3)
  peakBytes           BigInt
  /// Stored bytes when the day ended: where the next day starts.
  endBytes            BigInt
  /// The last StorageEvent the day took in; the next day reads the log after it.
  lastEventId         BigInt
  /// The exact charge, in millionths of a paisa (half-up). A statement rounds the month's sum once.
  chargeMicroPaise    BigInt
  priceBookId         String   @db.Uuid
  /// When the close wrote it.
  createdAt           DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceBook PriceBook @relation(fields: [priceBookId], references: [id])

  @@id([userId, day])
}

enum StatementStatus {
  /// To be collected (P5's settlement).
  OPEN
  /// Below the minimum charge: its total goes into the account's next statement (`carriedIntoId`
  /// says which, once there is one).
  CARRIED
}

/// One account's bill for one IST calendar month, closed on the 1st (billing.closeCycle) from the
/// month's UsageDays. Never changed once made, except to record where a carried total went. Kept
/// after the account is deleted (the delete-account page's billing records).
model Statement {
  id                     String          @id @default(uuid()) @db.Uuid
  userId                 String          @db.Uuid
  /// The month: its first and last IST dates.
  periodStart            DateTime        @db.Date
  periodEnd              DateTime        @db.Date
  /// The month's byte-seconds, and the part above each day's free allowance.
  byteSeconds            Decimal         @db.Decimal(38, 3)
  billableByteSeconds    Decimal         @db.Decimal(38, 3)
  /// The price book that priced the month, with its numbers copied so the statement explains itself.
  priceBookId            String          @db.Uuid
  storagePaisePerGbMonth BigInt
  gstBasisPoints         Int
  minimumChargePaise     BigInt
  /// round_half_up(Σ the days' micro-paise): the month's storage charge.
  subtotalPaise          BigInt
  /// round_half_up(subtotal × GST rate).
  gstPaise               BigInt
  /// An earlier statement's total that was below the minimum charge, carried into this one.
  carriedInPaise         BigInt
  totalPaise             BigInt
  status                 StatementStatus
  /// A CARRIED statement: the later statement its total went into. Null until there is one.
  carriedIntoId          String?         @unique @db.Uuid
  createdAt              DateTime        @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceBook PriceBook @relation(fields: [priceBookId], references: [id])

  @@unique([userId, periodStart])
}

/// How an account pays. For now only the monthly limit, which the usage alerts measure against; P5
/// adds the auto-pay mandate that sets it (the limit is the mandate's maximum) and the balance.
model BillingAccount {
  userId            String   @id @db.Uuid
  /// The monthly auto-pay limit, in paise. Null: no limit, so no usage alerts.
  monthlyLimitPaise BigInt?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DeliveryState {
  /// This kind of notification doesn't use the channel.
  NONE
  /// Not sent yet: waiting for the outbox, or retrying an error that may pass.
  PENDING
  SENT
  /// Not sent, on purpose: the channel isn't configured, there's nowhere to send it (no device,
  /// no email address), or a bigger alert superseded it.
  SKIPPED
  /// Gave up: a permanent error, or the retries ran out.
  FAILED
}

/// A billing alert to the user (docs/BACKEND_PLAN.md §7.4): push (FCM) and/or email (SES), sent
/// through the outbox. `dedupeKey` is unique, so each alert is made, and sent, at most once.
model Notification {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  /// What makes it once-only, e.g. "limit80:{userId}:2026-10:10000" (that month, that limit) or
  /// "statement:{statementId}".
  dedupeKey   String        @unique
  /// LIMIT_80 | LIMIT_100 | PROJECTED_OVER_LIMIT | STATEMENT_READY
  type        String
  /// What the message says: amounts as paise strings, the month, the statement's id.
  payload     Json
  push        DeliveryState
  email       DeliveryState
  /// Why a channel was skipped or failed, for whoever looks.
  pushDetail  String?
  emailDetail String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Work to do after a transaction commits, retried until it succeeds: deleting objects from R2,
/// aborting unfinished multipart uploads, sending notifications. Queued in the same transaction as
/// the change that needs it, so it can't be lost; drained every minute by the worker.
model OutboxJob {
  id        BigInt   @id @default(autoincrement())
  /// DELETE_OBJECTS | CLEANUP_UPLOAD | DELETE_PREFIX | SEND_NOTIFICATION
  kind      String
  payload   Json
  /// Not before this. A claimed job's lease also lives here.
  runAfter  DateTime @default(now())
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@index([runAfter, id])
}

/// Scheduled-job bookkeeping (deviation D5), keyed by job and period: the IST date. A daily job
/// runs once per period; an interval job keeps one row per day, `attempts` counting that day's
/// runs. Failures are visible and retried.
model JobRun {
  name       String
  periodKey  String
  /// RUNNING | SUCCEEDED | FAILED
  status     String
  attempts   Int       @default(1)
  summary    String?
  error      String?
  startedAt  DateTime
  finishedAt DateTime?

  @@id([name, periodKey])
}

/// One signed-in device (deviation D1 in docs/BACKEND_PLAN.md).
///
/// Access tokens are short-lived JWTs carrying this row's id (`sid`); every authenticated request
/// checks that the session still exists, so revoking a device takes effect immediately.
///
/// The refresh token is the long-lived credential:
///   - Only SHA-256 hashes are stored. The token is 256 bits of CSPRNG output, so a fast hash is
///     right: there is nothing guessable to slow down, and lookup is a unique-index hit.
///   - Every refresh ROTATES it. The replaced hash is kept in `previousTokenHash`, so a replay can be
///     recognised: inside a short grace window it is a phone retrying a refresh whose response was
///     lost (it gets new tokens); after it, the token was copied (theft) and the session is revoked.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  /// SHA-256 (hex) of the current refresh token. Never the raw value.
  refreshTokenHash  String    @unique
  /// SHA-256 (hex) of the refresh token this one replaced, for replay detection. Null until the
  /// first rotation.
  previousTokenHash String?   @unique
  /// When `previousTokenHash` was replaced — the start of its retry grace window.
  rotatedAt         DateTime?
  /// The app's per-install id (X-Device-Id). Signing in again on the same install replaces the old
  /// session, so reinstalls don't pile up devices.
  deviceId          String?
  /// Shown in the user's "signed-in devices" list. Client-supplied hints, never trusted for security.
  deviceName        String?
  platform          String?
  appVersion        String?
  /// The device's FCM registration token. It lives on the session, so a signed-out device stops
  /// receiving notifications. Unique: a token moves to whichever session registered it last.
  pushToken         String?   @unique
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  /// Sliding idle expiry, pushed forward on every refresh.
  expiresAt         DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
}
