# BenchBox backend environment. Copy to .env for local development.
# The production .env lives only on the server (/opt/apps/benchbox/BenchBox-Backend/.env) — never in git.
# Every value is read in exactly one place: src/config/env.ts, which refuses to start on bad config.

# Port the app listens on (inside the container it is 8080; nginx reaches it via APP_HOST_PORT).
PORT=8080

# Public origin of this backend, no trailing slash. The absolute legal links in GET /config are
# built from it (HOA protocol 12), so it must be the real public URL even in local development.
APP_PUBLIC_URL=https://benchbox.ferbotz.com

# PostgreSQL. Local: docker-compose.yml's db, or any local server. Production: the host Postgres,
# reached from the container as host.docker.internal.
DATABASE_URL=postgresql://benchbox:benchbox@localhost:5432/benchbox?schema=public

# Signs access tokens (HS256). At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
# Access-token lifetime. Default 1h; "never" is refused (BenchBox deviation D1 — refresh tokens keep
# users signed in).
# JWT_EXPIRES_IN=1h

# Google OAuth WEB client id(s) — the app's server client id; the idToken's `aud` must match.
# Comma-separated if more than one. Unset → POST /api/v1/auth/google answers 503.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Cloudflare R2, where file bytes live. All four or none: none → uploads, downloads and
# thumbnails answer 503 and the storage jobs skip; a partial set refuses to start. Locally, point
# these at the DEV bucket (benchbox-files-dev) — check:r2-live refuses any bucket not named dev/test.
# The values are in the BenchBox details doc (R2 section); never paste them anywhere else.
# R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=benchbox-files-dev
# Optional: another S3-compatible endpoint (a local stand-in). Production leaves it unset.
# R2_ENDPOINT=http://localhost:9000

# Billing alerts by push: Firebase Cloud Messaging, project benchbox-75a31. The three fields of a
# Firebase service account's JSON key (project_id, client_email, private_key). All three or none:
# none → push notifications are skipped (and each skip logged); a partial set refuses to start. The
# private key goes on ONE line with its newlines written as \n, inside double quotes. Values live in
# the BenchBox details doc; never paste them anywhere else.
# FCM_PROJECT_ID=benchbox-75a31
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@benchbox-75a31.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Billing alerts by email: Amazon SES. The keys of an IAM user that may only send email (not the
# box's instance role, which every app on the box shares), and a From address on a domain verified
# in SES. All four or none: none → emails are skipped (and each skip logged); a partial set refuses
# to start.
# SES_REGION=ap-south-1
# SES_FROM=BenchBox <billing@ferbotz.com>
# SES_ACCESS_KEY_ID=...
# SES_SECRET_ACCESS_KEY=...

# Production only: the loopback port docker-compose.prod.yml publishes on the shared box
# (127.0.0.1:<port> → container 8080). 8080 and 8090–8093 are taken by other apps.
# APP_HOST_PORT=8094

# Optional JSON patch over the default remote config served by GET /config — flip a switch for
# every installed app WITHOUT a code deploy (edit, then recreate the container). Keys must exist
# in src/modules/remoteConfig/remoteConfig.defaults.ts with the same types, or the app refuses
# to start. See docs/REMOTE_CONFIG.md.
# REMOTE_CONFIG_OVERRIDES={"maintenance":{"enabled":true,"message":"Back in 10 minutes"}}
