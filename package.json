{
  "name": "benchbox-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for BenchBox — pay-as-you-use cloud storage",
  "license": "UNLICENSED",
  "main": "dist/app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/app.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only --exit-child src/worker.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "check:config": "ts-node src/scripts/check-remote-config.ts",
    "check:legal": "ts-node src/scripts/check-legal.ts",
    "check:auth": "ts-node src/scripts/check-auth.ts",
    "check:auth-db": "ts-node src/scripts/check-auth-db.ts",
    "check:tree": "ts-node src/scripts/check-tree.ts",
    "check:tree-db": "ts-node src/scripts/check-tree-db.ts",
    "check:storage": "ts-node src/scripts/check-storage.ts",
    "check:storage-db": "ts-node src/scripts/check-storage-db.ts",
    "check:r2-live": "ts-node src/scripts/check-r2-live.ts",
    "check:all": "npm run check:config && npm run check:legal && npm run check:auth && npm run check:tree && npm run check:storage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
